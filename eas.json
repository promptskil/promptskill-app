{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    },
    "staging": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
